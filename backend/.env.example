# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string. Leave empty in development to auto-start an
# in-memory MongoDB (mongodb-memory-server) so the project runs with zero setup.
MONGODB_URI=mongodb+srv://<db_username>:PWnTR2N3cqHMsiUS@cluster0.m3obpaj.mongodb.net/

# Secret used to sign JWTs. Change in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Static API key for admin endpoints (changing competition dates, etc.)
ADMIN_API_KEY=admin-dev-key

# How long a reserved (unpaid) spot is held before it is released (seconds)
RESERVATION_TTL_SECONDS=600

# How often the background job releases expired reservations (ms)
RESERVATION_SWEEP_INTERVAL_MS=15000

# Comma-separated list of allowed CORS origins ("*" for all)
CORS_ORIGINS=*

# Public base URL for referral links
REFERRAL_BASE_URL=https://feedants.com/r

# Razorpay (optional). Leave empty to use the built-in mock checkout.
# Test keys: Razorpay Dashboard -> Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> Add (URL: https://<public-host>/api/v1/webhooks/razorpay, event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=
