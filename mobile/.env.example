# Base URL of the backend API (no trailing slash).
# Leave unset to auto-detect: the app uses the Expo dev-server host on a
# physical device, 10.0.2.2 on the Android emulator, localhost on iOS sim.
# Examples:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
#   EXPO_PUBLIC_API_URL=https://api.feedants.example.com/api/v1
EXPO_PUBLIC_API_URL=

# Demo identity the app signs in as on first launch (no password; demo auth).
EXPO_PUBLIC_DEMO_EMAIL=demo@feedants.app
EXPO_PUBLIC_DEMO_NAME=Devang
